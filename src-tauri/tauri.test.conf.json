{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentero Test",
  "identifier": "com.poco-ai.agentero.test",
  "build": {
    "beforeBuildCommand": "pnpm cli:bundle:release && pnpm pdfium:stage && VITE_AGENTERO_MACOS_TEST_BUILD=1 pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Agentero Test"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["agentero-test"]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
